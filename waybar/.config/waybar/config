{
  "layer": "top",
  "position": "top",
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  // MODULES — functional split + machine-specific override last
  // Para MSI:    usar workspaces_msi.json
  // Para Legion: usar workspaces_legion.json
  "include": [
    "~/.config/waybar/modules/workspaces.json",
    "~/.config/waybar/modules/mail.json",
    "~/.config/waybar/modules/updates.json",
    "~/.config/waybar/modules/system.json",
    "~/.config/waybar/modules/network.json",
    "~/.config/waybar/modules/audio.json",
    "~/.config/waybar/modules/clock.json",
    "~/.config/waybar/modules/battery.json",
    "~/.config/waybar/modules/power.json",
    "~/.config/waybar/modules/clipboard.json",
    "~/.config/waybar/modules/workspaces_msi.json"
  ],

  /*==== MODULES ORDER ====*/

  /*MODULES LEFT*/
  "modules-left": [
    "custom/archicon",
    "hyprland/workspaces",
    "custom/mail",
    "tray"
  ],

  /*MODULES CENTER*/
  "modules-center": [
    "hyprland/window"
  ],

  /*MODULES RIGHT*/
  "modules-right": [
    "custom/updates",
    "group/hardware",
    "network",
    "pulseaudio",
    "bluetooth",
    "custom/clipboard",
    "clock",
    "battery",
    "group/power"
  ]
}
