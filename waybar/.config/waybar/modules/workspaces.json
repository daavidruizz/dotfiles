{
  "custom/archicon": {
    "format": "  ",
    "on-click": "wofi --show drun",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace m+1",
    "on-scroll-down": "hyprctl dispatch workspace m-1",
    "format-icons": {
      "urgent": "",
      "default": ""
    },
    "sort-by-number": true,
    "all-outputs": false
  },

  "custom/mail": {
    "format": "  ",
    "on-click": "google-chrome-stable --app=https://outlook.live.com/mail/0/",
    "on-click-right": "google-chrome-stable --app=https://mail.google.com/mail/u/0/#inbox",
    "tooltip": false
  },

  "tray": {
    "icon-size": 10,
    "spacing": 10
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "tooltip": false
  }
}
