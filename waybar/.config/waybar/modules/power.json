{
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power Off  [Right click to cancel]",
    "on-click": "~/.config/hypr/scripts/power.sh shutdown",
    "on-click-right": "touch /tmp/.power_cancel"
  },

  "custom/power-lock": {
    "format": "󰌾",
    "tooltip-format": "Lock",
    "on-click": "~/.config/hypr/scripts/power.sh lock"
  },

  "custom/power-logout": {
    "format": "󰍃",
    "tooltip-format": "Log Out",
    "on-click": "~/.config/hypr/scripts/power.sh exit"
  },

  "custom/power-suspend": {
    "format": "󰤄",
    "tooltip-format": "Suspend",
    "on-click": "~/.config/hypr/scripts/power.sh suspend"
  },

  "custom/power-reboot": {
    "format": "",
    "tooltip-format": "Restart  [Right click to cancel]",
    "on-click": "~/.config/hypr/scripts/power.sh reboot",
    "on-click-right": "touch /tmp/.power_cancel"
  },

  "custom/power-shutdown": {
    "format": "⏻",
    "tooltip-format": "Power Off  [Right click to cancel]",
    "on-click": "~/.config/hypr/scripts/power.sh shutdown",
    "on-click-right": "touch /tmp/.power_cancel"
  },

  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "power-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/power-lock",
      "custom/power-logout",
      "custom/power-suspend",
      "custom/power-reboot"
    ]
  }
}
